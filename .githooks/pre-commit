#!/bin/sh
set -e

format_before=$(mktemp)
format_after=$(mktemp)
trap 'rm -f "$format_before" "$format_after"' EXIT HUP INT TERM
git diff --binary --no-ext-diff >"$format_before"
bun run format
git diff --binary --no-ext-diff >"$format_after"
if ! cmp -s "$format_before" "$format_after"; then
	printf '%s
' 'bun run format changed the working tree; review and stage those changes, then retry the commit.' >&2
	exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$files" ]; then
	exit 0
fi

format_files=$(printf "%s\n" "$files" | grep -E '^((app|web|core|sdk|net)/.*\.(ts|tsx|js|html|css|scss)|[^/]+\.json|\.github/.*\.(json|yml)|\.oxfmtrc\.json|\.golangci\.yml|tsconfig.*\.json)$' | grep -v '^\.protoc-manifest\.json$' || true)
if [ -n "$format_files" ]; then
	printf "%s\n" "$format_files" | xargs node_modules/.bin/oxfmt
	printf "%s\n" "$format_files" | xargs git add
fi

js_files=$(printf "%s\n" "$files" | grep -E '\.(js|mjs|ts|tsx)$' || true)
if [ -n "$js_files" ]; then
	printf "%s\n" "$js_files" | xargs node_modules/.bin/oxlint --no-error-on-unmatched-pattern
fi

go_files=$(printf "%s\n" "$files" | grep -E '\.go$' || true)
if [ -n "$go_files" ]; then
	printf "%s\n" "$go_files" | xargs gofmt -w
	printf "%s\n" "$go_files" | xargs git add

	go_pkg_dirs=$(printf "%s\n" "$go_files" | xargs -n1 dirname | sort -u | sed 's#^\.$#.#; s#^\./##; s#^#./#')

	# A package whose files the host platform excludes, such as a js-only one,
	# cannot be listed or compiled here; the wasm build in CI covers it. Drop it
	# and treat every other listing error as a failure.
	list_err=$(mktemp)
	go_pkgs=""
	for dir in $go_pkg_dirs; do
		if GOFLAGS="-mod=mod -tags=purego" go list "$dir" >/dev/null 2>>"$list_err"; then
			go_pkgs="$go_pkgs $dir"
		fi
	done
	if grep -v 'build constraints exclude all Go files' "$list_err" | grep -q .; then
		cat "$list_err" >&2
		rm -f "$list_err"
		exit 1
	fi
	rm -f "$list_err"
fi

if [ -n "$go_pkgs" ]; then
	go_fix_before=$(git diff -- $go_pkg_dirs)
	GOFLAGS="-mod=mod -tags=purego" go fix $go_pkgs
	go_fix_after=$(git diff -- $go_pkg_dirs)
	if [ "$go_fix_before" != "$go_fix_after" ]; then
		printf "go fix changed files in staged Go package(s); review and stage them before committing:\n" >&2
		git diff --name-only -- $go_pkg_dirs >&2
		exit 1
	fi

	# The compile check (tests included) and the aptre lint both read the same
	# packages and share the purego build cache that go fix above just warmed, so
	# run them in parallel. Capture each output and fail the commit if either
	# fails, printing both logs.
	compile_out=$(mktemp)
	lint_out=$(mktemp)
	GOFLAGS="-mod=mod -tags=purego" go test -run '^$' $go_pkgs >"$compile_out" 2>&1 &
	compile_pid=$!
	bun run go:aptre -- lint $go_pkgs >"$lint_out" 2>&1 &
	lint_pid=$!
	go_rc=0
	wait "$compile_pid" || go_rc=1
	wait "$lint_pid" || go_rc=1
	if [ "$go_rc" -ne 0 ]; then
		cat "$compile_out" "$lint_out" >&2
		rm -f "$compile_out" "$lint_out"
		exit 1
	fi
	rm -f "$compile_out" "$lint_out"
fi

if printf "%s\n" "$files" | grep -Eq '^go\.mod$'; then
	.githooks/check-go-mod-ref-pins
fi
