#!/bin/sh
set -e

files=$(git diff --cached --name-only -z --diff-filter=ACMR | tr '\0' '\n')
if [ -z "$files" ]; then
	exit 0
fi

# Format and restage only files whose worktree matches the index. Restaging a
# partially staged file would fold its unstaged edits into the commit, so
# compare its staged blob with the formatter output instead and refuse the
# commit when they differ.
unstaged_list=$(mktemp)
staged_blob=$(mktemp)
formatted_blob=$(mktemp)
trap 'rm -f "$unstaged_list" "$staged_blob" "$formatted_blob"' EXIT HUP INT TERM
git diff --name-only -z | tr '\0' '\n' >"$unstaged_list"

# whole_files prints the listed files that have no unstaged edits.
whole_files() {
	printf "%s\n" "$1" | grep -Fxv -f "$unstaged_list" || true
}

# check_partial_files fails the commit when the staged blob of a listed file
# with unstaged edits differs from the output of the formatter command "$2",
# which reads the blob on stdin and receives the path as its last argument.
check_partial_files() {
	unformatted=
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		git show ":$f" >"$staged_blob"
		$2 "$f" <"$staged_blob" >"$formatted_blob"
		if ! cmp -s "$staged_blob" "$formatted_blob"; then
			unformatted="$unformatted$f
"
		fi
	done <<PARTIAL_FILES
$(printf "%s\n" "$1" | grep -Fx -f "$unstaged_list" || true)
PARTIAL_FILES
	if [ -n "$unformatted" ]; then
		printf 'staged content needs formatting; format and restage these partially staged files:\n%s' "$unformatted" >&2
		exit 1
	fi
}

# oxfmt_stdin formats stdin as the file named by $1.
oxfmt_stdin() {
	node_modules/.bin/oxfmt --stdin-filepath="$1"
}

# gofmt_stdin formats Go source from stdin.
gofmt_stdin() {
	gofmt
}

format_files=$(printf "%s\n" "$files" | grep -E '^((app|web|core|sdk|net)/.*\.(ts|tsx|js|html|css|scss)|[^/]+\.json|\.github/.*\.(json|yml)|\.oxfmtrc\.json|\.golangci\.yml|tsconfig.*\.json)$' | grep -vE '^\.protoc(-python-[a-z-]+)?-manifest\.json$' || true)
if [ -n "$format_files" ]; then
	format_whole=$(whole_files "$format_files")
	if [ -n "$format_whole" ]; then
		printf "%s\n" "$format_whole" | tr '\n' '\0' | xargs -0 node_modules/.bin/oxfmt
		printf "%s\n" "$format_whole" | tr '\n' '\0' | xargs -0 git add
	fi
	check_partial_files "$format_files" oxfmt_stdin
fi

js_files=$(printf "%s\n" "$files" | grep -E '\.(js|mjs|ts|tsx)$' || true)
if [ -n "$js_files" ]; then
	printf "%s\n" "$js_files" | tr '\n' '\0' | xargs -0 node_modules/.bin/oxlint --no-error-on-unmatched-pattern
fi

go_files=$(printf "%s\n" "$files" | grep -E '\.go$' || true)
if [ -n "$go_files" ]; then
	go_whole=$(whole_files "$go_files")
	if [ -n "$go_whole" ]; then
		printf "%s\n" "$go_whole" | tr '\n' '\0' | xargs -0 gofmt -w
		printf "%s\n" "$go_whole" | tr '\n' '\0' | xargs -0 git add
	fi
	check_partial_files "$go_files" gofmt_stdin

	go_pkg_dirs=$(printf "%s\n" "$go_files" | tr '\n' '\0' | xargs -0 -n1 dirname | sort -u | sed 's#^\.$#.#; s#^\./##; s#^#./#')

	# Keep explicit embedded literals: the retained Staticcheck IR predates Go
	# 1.27's promoted keyed-field syntax.
	# A package whose files the host platform excludes, such as a js-only one,
	# cannot be listed or compiled here; the wasm build in CI covers it. Drop it
	# and treat every other listing error as a failure. Read one directory per
	# line and pass them as quoted arguments so names with spaces survive.
	list_err=$(mktemp)
	set --
	while IFS= read -r go_pkg_dir; do
		[ -n "$go_pkg_dir" ] || continue
		# Nested tool modules own their dependency graph and have no aptre setup.
		# Check them from their package directory instead of the root module.
		module_file=$(cd "$go_pkg_dir" && go env GOMOD)
		if [ "$module_file" != "$(pwd)/go.mod" ]; then
			nested_before=$(git diff -- "$go_pkg_dir")
			(cd "$go_pkg_dir" && go fix -embedlit=false . && go test -run '^$' . && go vet .)
			nested_after=$(git diff -- "$go_pkg_dir")
			if [ "$nested_before" != "$nested_after" ]; then
				printf '%s\n' 'go fix changed a nested module; review and stage those changes before committing.' >&2
				exit 1
			fi
			continue
		fi
		if GOFLAGS="-mod=mod -tags=purego" go list "$go_pkg_dir" >/dev/null 2>>"$list_err"; then
			set -- "$@" "$go_pkg_dir"
		fi
	done <<GO_PKG_DIRS
$go_pkg_dirs
GO_PKG_DIRS
	if grep -v 'build constraints exclude all Go files' "$list_err" | grep -q .; then
		cat "$list_err" >&2
		rm -f "$list_err"
		exit 1
	fi
	rm -f "$list_err"
fi

if [ "$#" -gt 0 ]; then
	go_fix_before=$(git diff -- "$@")
	GOFLAGS="-mod=mod -tags=purego" go fix -embedlit=false "$@"
	go_fix_after=$(git diff -- "$@")
	if [ "$go_fix_before" != "$go_fix_after" ]; then
		printf "go fix changed files in staged Go package(s); review and stage them before committing:\n" >&2
		git diff --name-only -- "$@" >&2
		exit 1
	fi

	# The compile check (tests included) and the aptre lint both read the same
	# packages and share the purego build cache that go fix above just warmed, so
	# run them in parallel. Capture each output and fail the commit if either
	# fails, printing both logs.
	compile_out=$(mktemp)
	lint_out=$(mktemp)
	GOFLAGS="-mod=mod -tags=purego" go test -run '^$' "$@" >"$compile_out" 2>&1 &
	compile_pid=$!
	bun run go:aptre -- lint "$@" >"$lint_out" 2>&1 &
	lint_pid=$!
	go_rc=0
	wait "$compile_pid" || go_rc=1
	wait "$lint_pid" || go_rc=1
	if [ "$go_rc" -ne 0 ]; then
		cat "$compile_out" "$lint_out" >&2
		rm -f "$compile_out" "$lint_out"
		exit 1
	fi
	rm -f "$compile_out" "$lint_out"
fi

if printf "%s\n" "$files" | grep -Eq '^go\.mod$'; then
	.githooks/check-go-mod-ref-pins
fi
