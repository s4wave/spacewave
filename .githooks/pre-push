#!/bin/sh
set -e

# pre-push refuses to move master to a commit that no stack branch holds.
#
# Spacewave lands on its stack branch (dev-stack on the canonical checkout,
# another *-stack name on another machine), and master moves only by
# fast-forward to a stack head whose CI run passed. A commit pushed straight to
# master skips that run and makes the whole stack rebase onto it. Git passes one
# line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
unset GIT_DIR GIT_WORK_TREE

remote=$1
zero=0000000000000000000000000000000000000000
stacks=
failed=
while read -r _ local_sha remote_ref _; do
	[ "$remote_ref" = refs/heads/master ] || continue
	if [ "$local_sha" = "$zero" ]; then
		echo "pre-push: refusing to delete master" >&2
		failed=1
		continue
	fi

	# Read the stack heads as the remote holds them now, once per push.
	if [ -z "$stacks" ]; then
		stacks=$(git ls-remote "$remote" 'refs/heads/*-stack' | cut -f1)
	fi
	held=
	for stack_sha in $stacks; do
		git cat-file -e "$stack_sha^{commit}" 2>/dev/null ||
			git fetch -q "$remote" "$stack_sha"
		if git merge-base --is-ancestor "$local_sha" "$stack_sha"; then
			held=1
			break
		fi
	done
	if [ -z "$held" ]; then
		echo "pre-push: master moves only to a commit a *-stack branch holds;" >&2
		echo "push to the stack branch and let master fast-forward after its CI passes" >&2
		failed=1
	fi
done

[ -z "$failed" ]
