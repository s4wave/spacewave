{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortTailwindcss": {},
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".bldr",
    "app/prerender/dist",
    ".#*",
    ".*.swp",
    ".vs",
    "lean/lake-manifest.json",
    // bun run gen writes the protoc manifests; formatting would churn on each gen.
    ".protoc-*manifest.json",
    // The Go vector test rewrites this file and compares its bytes exactly.
    "core/sobject/testdata/operation-log-vectors.json",
    // A recorded Cloudflare response, kept byte for byte as the API sent it.
    "net/transport/webrtc/relay/cloudflare/testdata/generate-ice-servers.json"
  ]
}
