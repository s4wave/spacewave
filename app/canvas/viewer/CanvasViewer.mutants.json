[
  {
    "name": "a failed send draws over the failed body",
    "replace": [
      [
        "    [] e = \"action\" -> IF Body = \"stage\" /\\ action = \"failed\"",
        "    [] e = \"action\" -> IF action = \"failed\""
      ]
    ],
    "expect": "NothingDrawnUnfailed"
  },
  {
    "name": "an edit shows before a canvas arrives",
    "replace": [
      [
        "    \\cup (IF Body = \"stage\" THEN {\"edit\"} ELSE {})",
        "    \\cup (IF Body # \"failed\" THEN {\"edit\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "Retry of the watch shows while the handle has failed",
    "replace": [
      [
        "    \\cup (IF Reported = \"watch\" THEN {\"retryWatch\"} ELSE {})",
        "    \\cup (IF watch = \"failed\" \\/ handle = \"failed\" THEN {\"retryWatch\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "an edit clears the failed send's notice",
    "replace": [
      [
        "  /\\ nodes' \\in BOOLEAN\n  /\\ UNCHANGED <<handle, watch, kept, action>>",
        "  /\\ nodes' \\in BOOLEAN\n  /\\ action' = \"none\"\n  /\\ UNCHANGED <<handle, watch, kept>>"
      ]
    ],
    "expect": "SendNoticeStays"
  },
  {
    "name": "Dismiss shows with no failed send",
    "replace": [
      [
        "    \\cup (IF Draws(\"action\") = \"send\" THEN {\"dismiss\"} ELSE {})",
        "    \\cup (IF Body = \"stage\" THEN {\"dismiss\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  }
]
