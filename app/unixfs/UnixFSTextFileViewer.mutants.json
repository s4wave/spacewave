[
  {
    "name": "a failed read drops the draft",
    "replace": [
      [
        "  /\\ read' = \"failed\"\n  /\\ UNCHANGED <<disk, seen, mode, base,",
        "  /\\ read' = \"failed\"\n  /\\ mode' = \"reading\"\n  /\\ base' = \"none\"\n  /\\ UNCHANGED <<disk, seen,"
      ]
    ],
    "expect": "DraftNeverDropped"
  },
  {
    "name": "another writer's read replaces the draft",
    "replace": [
      [
        "  /\\ seen' = disk\n  /\\ UNCHANGED <<disk, mode, base,",
        "  /\\ seen' = disk\n  /\\ mode' = IF seen # \"none\" /\\ disk # seen THEN \"reading\" ELSE mode\n  /\\ base' = IF seen # \"none\" /\\ disk # seen THEN \"none\" ELSE base\n  /\\ UNCHANGED <<disk,"
      ]
    ],
    "expect": "DraftNeverDropped"
  },
  {
    "name": "Save shows over another writer's version",
    "replace": [
      [
        "    \\cup (IF Editing /\\ dirty /\\ ~Changed THEN {\"save\"} ELSE {})",
        "    \\cup (IF Editing /\\ dirty THEN {\"save\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "Edit shows on a read-only file",
    "replace": [
      [
        "  (IF mode = \"reading\" /\\ read = \"shown\" /\\ writable /\\ whole",
        "  (IF mode = \"reading\" /\\ read = \"shown\" /\\ whole"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "a read-only file says nothing",
    "replace": [
      [
        "    [] mode = \"reading\" /\\ read = \"shown\" /\\ ~writable -> \"Says why it is read-only\"\n",
        ""
      ]
    ],
    "expect": "NobodyIsStuck"
  },
  {
    "name": "the reducer accepts a plain Save over another writer's version",
    "replace": [
      [
        "SaveAccepted == Editing /\\ dirty /\\ seen = base",
        "SaveAccepted == Editing /\\ dirty"
      ]
    ],
    "expect": "NoBlindOverwrite"
  },
  {
    "name": "a plain Save lands without the store's check",
    "replace": [
      ["  /\\ overwrite \\/ disk \\in {base, \"gone\"}\n", "  /\\ TRUE\n"]
    ],
    "expect": "NoWriteOverTheirs"
  },
  {
    "name": "a removed file refuses a plain Save as another writer's version",
    "replace": [
      [
        "  /\\ disk \\notin {base, \"gone\"}\n  /\\ mode' = \"editing\"",
        "  /\\ disk # base\n  /\\ mode' = \"editing\""
      ]
    ],
    "expect": "RemovedFileSaves"
  }
]
