[
  {
    "name": "a stopped read keeps showing loading",
    "replace": [
      [
        "IF read = \"stopped\" /\\ got # \"complete\" THEN \"failed\"",
        "IF read = \"stopped\" /\\ got # \"complete\" THEN \"loading\""
      ]
    ],
    "expect": "LoadingIsTrue"
  },
  {
    "name": "the loading card names the images while only the VMs are read",
    "replace": [
      [
        "ELSE IF ImageView = \"loading\" THEN \"images\"",
        "ELSE IF ImageView = \"loading\" \\/ vms = \"loading\" THEN \"images\""
      ]
    ],
    "expect": "LoadingIsTrue"
  },
  {
    "name": "a failure offers no Retry",
    "replace": [
      [
        "(IF ImageView = \"failed\" \\/ Notice THEN {\"retryImages\"} ELSE {})",
        "(IF Notice THEN {\"retryImages\"} ELSE {})"
      ]
    ],
    "expect": "FailureHasNextStep"
  },
  {
    "name": "a stopped watch over a complete listing stays quiet",
    "replace": [
      ["Notice == got = \"complete\" /\\ read = \"stopped\"", "Notice == FALSE"]
    ],
    "expect": "StopIsShown"
  },
  {
    "name": "seeds before the listing is complete",
    "replace": [
      [
        "  /\\ ImageView = \"ready\"\n  /\\ vms",
        "  /\\ ImageView # \"failed\"\n  /\\ vms"
      ]
    ],
    "expect": "SeedOnlyFromRead"
  },
  {
    "name": "seeds before the VMs are read",
    "replace": [
      [
        "  /\\ ImageView = \"ready\"\n  /\\ vms = \"read\"\n",
        "  /\\ ImageView = \"ready\"\n"
      ]
    ],
    "expect": "SeedOnlyFromRead"
  }
]
