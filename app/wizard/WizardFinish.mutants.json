[
  {
    "name": "the create commits apart from the wizard delete",
    "replace": [
      ["       /\\ wizard' = FALSE\n", "       /\\ wizard' \\in BOOLEAN\n"]
    ],
    "expect": "WizardXorObject"
  },
  {
    "name": "the delete lands without the index move",
    "replace": [
      [
        "       /\\ index' = IF index = \"wizard\" THEN \"object\" ELSE index",
        "       /\\ index' = index"
      ]
    ],
    "expect": "IndexNamesLive"
  },
  {
    "name": "a list that creates runs when the wizard is gone",
    "replace": [
      [
        "  IF wizard\n  THEN /\\ objects' = objects + 1",
        "  IF TRUE\n  THEN /\\ objects' = objects + 1"
      ]
    ],
    "expect": "AtMostOneObject"
  },
  {
    "name": "the index move trusts what the tab's lagging watch showed",
    "replace": [
      [
        "IF index = \"wizard\" THEN \"object\"",
        "IF r = \"wizard\" /\\ index = r THEN \"object\""
      ]
    ],
    "expect": "IndexNamesLive"
  },
  {
    "name": "the index move ignores the World's index",
    "replace": [
      ["IF index = \"wizard\" THEN \"object\"", "IF TRUE THEN \"object\""]
    ],
    "expect": "MovedIndexStays"
  },
  {
    "name": "a discard keeps what the list staged",
    "replace": [
      [
        "  /\\ live' = [live EXCEPT ![t] = FALSE]\n  /\\ UNCHANGED <<seen, orphan, wizard, objects, index, moved>>",
        "  /\\ live' = [live EXCEPT ![t] = FALSE]\n  /\\ objects' = objects + 1\n  /\\ UNCHANGED <<seen, orphan, wizard, index, moved>>"
      ]
    ],
    "expect": "WizardXorObject"
  },
  {
    "name": "Finish shows while a press runs",
    "replace": [
      [
        "  (IF control[t] = \"idle\" /\\ wizard THEN {\"finish\"} ELSE {})",
        "  (IF control[t] \\in {\"idle\", \"finishing\"} /\\ wizard THEN {\"finish\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "Retry shows after the wizard is gone",
    "replace": [
      [
        "    \\cup (IF control[t] = \"failed\" /\\ wizard THEN {\"retry\"} ELSE {})",
        "    \\cup (IF control[t] = \"failed\" THEN {\"retry\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  },
  {
    "name": "a gone wizard offers nothing",
    "replace": [["    \\cup (IF Gone(t) THEN {\"close\"} ELSE {})", ""]],
    "expect": "NobodyIsStuck"
  },
  {
    "name": "a refused list offers Retry",
    "replace": [
      [
        "    \\cup (IF control[t] = \"failed\" /\\ wizard THEN {\"retry\"} ELSE {})",
        "    \\cup (IF control[t] \\in {\"failed\", \"gone\"} /\\ ~live[t] THEN {\"retry\"} ELSE {})"
      ]
    ],
    "expect": "EveryShownActionWorks"
  }
]
