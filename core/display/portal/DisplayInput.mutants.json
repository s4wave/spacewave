[
  {
    "name": "A viewer that was never admitted can hold a key",
    "replace": [
      [
        "v \\in admitted \\ held",
        "v \\notin held"
      ]
    ],
    "expect": "OnlyAdmittedHold"
  },
  {
    "name": "One viewer releases a key while another still holds it",
    "replace": [
      [
        "/\\ down' = (held' # {})\n  /\\ UNCHANGED state",
        "/\\ down' = FALSE\n  /\\ UNCHANGED state"
      ]
    ],
    "expect": "DownHasHolder"
  },
  {
    "name": "The daemon cancels its session while some input stays down",
    "replace": [
      [
        "/\\ down' = FALSE\n\nEnd ==",
        "/\\ UNCHANGED down\n\nEnd =="
      ]
    ],
    "expect": "DaemonEndReleasedInput"
  }
]
