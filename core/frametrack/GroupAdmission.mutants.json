[
  {
    "name": "A group supplies a live ID from the wrong peer",
    "replace": [
      [
        "IF group.id \\in live /\\ Owner(group.id) = group.peer",
        "IF group.id \\in live"
      ]
    ],
    "expect": "OnlyLiveDeviceReads"
  },
  {
    "name": "An ended subscription still gets groups",
    "replace": [
      [
        "IF group.id \\in live /\\ Owner(group.id) = group.peer",
        "IF Owner(group.id) = group.peer"
      ]
    ],
    "expect": "OnlyLiveDeviceReads"
  },
  {
    "name": "A reader outlives its subscription",
    "replace": [["(group.phase = \"reading\" /\\ group.id = id)", "FALSE"]],
    "expect": "OnlyLiveDeviceReads"
  }
]
