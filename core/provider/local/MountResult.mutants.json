[
  {
    "name": "a canceled callback claims the mount result",
    "replace": [
      [
        "            /\\ r \\in live\n            /\\ phase' = [phase EXCEPT ![r] = \"claimed\"]",
        "            /\\ phase' = [phase EXCEPT ![r] = \"claimed\"]"
      ]
    ],
    "expect": "NewestOwns"
  },
  {
    "name": "a waiter accepts a captured result without validating replacement",
    "replace": [
      [
        "IF captured = publication THEN captured ELSE 0",
        "captured"
      ]
    ],
    "expect": "NoRetiredResult"
  },
  {
    "name": "a retired load clears its successor restart condition",
    "replace": [
      [
        "IF loadOwner = 1 THEN FALSE ELSE awaiting",
        "FALSE"
      ]
    ],
    "expect": "RefusalKeepsRevive"
  },
  {
    "name": "a waiter ignores a stopped account",
    "replace": [
      [
        "\\/ StopAccount \\/ CancelResult",
        "\\/ StopAccount"
      ],
      [
        "        /\\ WF_resultVars(CancelResult)\n",
        ""
      ]
    ],
    "expect": "AccountWaitEnds"
  },
  {
    "name": "a retired mount trusts a recreated host key",
    "replace": [
      [
        "IF (HostPresent /\\ MountLive) THEN \"held\" ELSE \"refused\"",
        "IF HostPresent THEN \"held\" ELSE \"refused\""
      ]
    ],
    "expect": "NoCrossLifetimeWrite"
  },
  {
    "name": "a retired mount accepts the recreated object's snapshot",
    "replace": [
      [
        "readPhase' = IF MountLive THEN \"accepted\" ELSE \"refused\"",
        "readPhase' = \"accepted\""
      ]
    ],
    "expect": "NoCrossLifetimeRead",
    "config": "MountResult-snapshot.cfg"
  }
]
