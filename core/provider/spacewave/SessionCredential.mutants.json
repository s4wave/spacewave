[
  {
    "name": "lock leaves the key live",
    "replace": [
      [
        "/\\ phase' \\in {\"locking\", \"loggingout\"} /\\ live' = {}",
        "/\\ phase' \\in {\"locking\", \"loggingout\"} /\\ live' = live"
      ]
    ],
    "expect": "LockedHasNoKey",
    "config": "SessionCredential.cfg"
  },
  {
    "name": "a retained key signs after revocation",
    "replace": [
      [
        "/\\ worker \\in live /\\ keyUse = 0",
        "/\\ worker # 0 /\\ keyUse = 0"
      ]
    ],
    "expect": "NoStaleKeyUse",
    "config": "SessionCredential.cfg"
  },
  {
    "name": "a late registration restores the old generation",
    "replace": [
      [
        "/\\ transport' = \"starting\"\n  /\\ UNCHANGED <<phase, gen, live, worker, keyUse, stale, request, requestLive, staleSend>>",
        "/\\ transport' = \"starting\" /\\ live' = {worker}\n  /\\ UNCHANGED <<phase, gen, worker, keyUse, stale, request, requestLive, staleSend>>"
      ]
    ],
    "expect": "LockedHasNoKey",
    "config": "SessionCredential.cfg"
  },
  {
    "name": "lock waits for transport cleanup",
    "replace": [
      [
        "/\\ phase \\in {\"locking\", \"loggingout\"}\n  /\\ phase'",
        "/\\ phase \\in {\"locking\", \"loggingout\"} /\\ worker = 0\n  /\\ phase'"
      ]
    ],
    "expect": "ReturnIndependent",
    "config": "SessionCredential.cfg"
  },
  {
    "name": "a queued signed request survives revocation",
    "replace": [
      [
        "/\\ live' = {} /\\ requestLive' = FALSE",
        "/\\ live' = {} /\\ requestLive' = requestLive"
      ]
    ],
    "expect": "NoStaleRequest",
    "config": "SessionCredential.cfg"
  }
]
