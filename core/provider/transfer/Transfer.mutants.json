[
  {
    "name": "the import root never holds the copied World",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "  /\\ held' = held \\cup {cur}\n  /\\ step' = \"check\"",
        "  /\\ held' = held\n  /\\ step' = \"check\""
      ]
    ],
    "expect": "StateHeld"
  },
  {
    "name": "the state is written without checking the stage",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [["  /\\ IF cur \\in blocks\n", "  /\\ IF TRUE\n"]],
    "expect": "StateHeld"
  },
  {
    "name": "the write replaces whatever the target holds",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [["  /\\ IF tc[cur] = expect\n", "  /\\ IF TRUE\n"]],
    "expect": "StateHeld"
  },
  {
    "name": "a re-sync copies over an edited target",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "Rewritable(t, o) == o.ph = \"written\" /\\ t = Src(o.h)",
        "Rewritable(t, o) == o.ph = \"written\""
      ]
    ],
    "expect": "NoEditOverwritten"
  },
  {
    "name": "a listed Space with no origin counts as this source's",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "Rewritable(t, o) == o.ph = \"written\" /\\ t = Src(o.h)",
        "Rewritable(t, o) == (o.ph = \"written\" /\\ t = Src(o.h)) \\/ o = NoOrigin"
      ]
    ],
    "expect": "NoEditOverwritten"
  },
  {
    "name": "a written Space is skipped whatever the source head",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "/\\ t.k = \"src\" /\\ t.v = ver[cur] /\\ t.e = 0",
        "/\\ t.k = \"src\" /\\ t.e = 0"
      ]
    ],
    "expect": "Finishes"
  },
  {
    "name": "cleanup deletes without checking the head",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "  /\\ pc = \"cleanup\" /\\ s \\in entries \\cap src /\\ AtHead(s)\n",
        "  /\\ pc = \"cleanup\" /\\ s \\in entries \\cap src\n"
      ]
    ],
    "expect": "CleanupAtHead"
  },
  {
    "name": "a delete on the target keeps the origin",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "  /\\ origin' = [origin EXCEPT ![s] = NoOrigin]\n",
        "  /\\ UNCHANGED origin\n"
      ]
    ],
    "expect": "ArrivingUntouched"
  },
  {
    "name": "a source moved during the run leaves the Space not moved",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "  /\\ pc' = \"spaces\"\n  /\\ moved' = moved \\ {s}\n  /\\ UNCHANGED <<mode, picked, entries, cur, step, expect, cv, notMoved,",
        "  /\\ pc' = \"notmoved\"\n  /\\ moved' = moved \\ {s} /\\ notMoved' = notMoved \\cup {s}\n  /\\ UNCHANGED <<mode, picked, entries, cur, step, expect, cv,"
      ]
    ],
    "expect": "NotMovedJustified"
  },
  {
    "name": "a shared Space is copied",
    "config": "Transfer-tgt-local-src-local-shared-a.cfg",
    "replace": [["     IN CASE cur \\in shared ->", "     IN CASE FALSE ->"]],
    "expect": "SharedNotCopied"
  },
  {
    "name": "a cloud source deletes a shared Space the target is a member of",
    "config": "Transfer-tgt-local-src-cloud-shared-a.cfg",
    "replace": [
      [
        "               /\\ IF t = Member /\\ ~cloudSrc\n",
        "               /\\ IF t = Member\n"
      ],
      [
        "  IF s \\in shared THEN tc[s] = Member /\\ ~cloudSrc\n",
        "  IF s \\in shared THEN tc[s] = Member\n"
      ]
    ],
    "expect": "MembersKeepShared"
  },
  {
    "name": "an arriving Space can be written by the person",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "  /\\ Listed(s) /\\ touches < MaxTouches /\\ origin[s] # Added",
        "  /\\ Listed(s) /\\ touches < MaxTouches"
      ]
    ],
    "expect": "ArrivingUntouched"
  },
  {
    "name": "Migrate cleans up without copying the key",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "CASE mode = \"migrate\" /\\ ~cloudTgt -> \"key\" [] Deletes",
        "CASE mode = \"migrate\" /\\ ~cloudTgt -> \"cleanup\" [] Deletes"
      ]
    ],
    "expect": "MigrateKeepsKey"
  },
  {
    "name": "a cloud target reads a configured Space at the source head as another's",
    "config": "Transfer-tgt-cloud-src-local-shared-none.cfg",
    "replace": [
      [
        "AtSourceHead(t, o) == (cloudTgt \\/ o.ph = \"written\")",
        "AtSourceHead(t, o) == (~cloudTgt /\\ o.ph = \"written\")"
      ]
    ],
    "expect": "NotMovedJustified"
  },
  {
    "name": "the cloud target ignores a stored origin",
    "config": "Transfer-tgt-cloud-src-local-shared-none.cfg",
    "replace": [
      [
        "          [] cloudTgt /\\ o = NoOrigin ->\n",
        "          [] cloudTgt ->\n"
      ]
    ],
    "expect": "NotMovedJustified"
  },
  {
    "name": "a re-sync copies over a target whose membership changed",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "Rewritable(t, o) == o.ph = \"written\" /\\ t = Src(o.h)",
        "Rewritable(t, o) == o.ph = \"written\" /\\ t.k = \"src\" /\\ t.v = o.h /\\ t.e = 0"
      ]
    ],
    "expect": "NoEditOverwritten"
  },
  {
    "name": "a run that leaves a Space not moved deletes the source session",
    "config": "Transfer-tgt-local-src-local-shared-none.cfg",
    "replace": [
      [
        "DeleteSession ==\n  /\\ pc = \"session\"\n",
        "DeleteSession ==\n  /\\ pc \\in {\"session\", \"notmoved\"}\n"
      ]
    ],
    "expect": "NotMovedKeepsSource"
  }
]
