[
  {
    "name": "one peer's recoverable failure restarts every other peer's stream",
    "replace": [
      [
        "phase' = [phase EXCEPT ![p] = \"backoff\"] /\\ lostTo' = lostTo",
        "phase' = [q \\in Peers |-> IF q = p \\/ phase[q] = \"streaming\" THEN \"backoff\" ELSE phase[q]] /\\ lostTo' = [q \\in Peers |-> lostTo[q] \\/ (q # p /\\ phase[q] = \"streaming\")]"
      ]
    ],
    "expect": "NoCrossPeerRestart",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "a recoverable failure is ignored, so the ended stream never reopens",
    "replace": [
      [
        "phase' = [phase EXCEPT ![p] = \"backoff\"] /\\ lostTo' = lostTo",
        "phase' = [phase EXCEPT ![p] = \"none\"] /\\ lostTo' = lostTo"
      ]
    ],
    "expect": "RecoverableReopens",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "a lifted end waits for the remote side instead of renewing",
    "replace": [
      [
        "/\\ owner = \"running\" /\\ phase[p] = \"watch\" /\\ seen[p]\n  /\\ phase' = [phase EXCEPT ![p] = \"offered\"]",
        "/\\ owner = \"running\" /\\ phase[p] = \"watch\" /\\ seen[p]\n  /\\ phase' = [phase EXCEPT ![p] = \"parked\"]"
      ]
    ],
    "expect": "LiftedReopens",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "the held-state watch takes its base when it starts, missing a change that landed before",
    "replace": [
      [
        "/\\ lastEnd' = [lastEnd EXCEPT ![p] = \"watch\"] /\\ seen' = seen",
        "/\\ lastEnd' = [lastEnd EXCEPT ![p] = \"watch\"] /\\ seen' = [seen EXCEPT ![p] = FALSE]"
      ]
    ],
    "expect": "LiftedReopens",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "a renewal outlives its peer's last link",
    "replace": [
      [
        "/\\ owner = \"running\" /\\ phase[p] \\in Renewing /\\ ~linked[p]",
        "/\\ FALSE"
      ]
    ],
    "expect": "RenewalNeedsLink",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "a new link does not pair the standing offers",
    "replace": [
      [
        "/\\ owner = \"running\" /\\ linked[p] /\\ fresh[p] /\\ phase[p] # \"stopped\"",
        "/\\ FALSE"
      ]
    ],
    "expect": "RelinkReopens",
    "config": "PeerRetry.cfg"
  },
  {
    "name": "the owner returns without joining its peer goroutines",
    "replace": [
      [
        "/\\ owner = \"stopping\" /\\ \\A p \\in Peers: phase[p] \\notin Active",
        "/\\ owner = \"stopping\""
      ]
    ],
    "expect": "Joined",
    "config": "PeerRetry.cfg"
  }
]
