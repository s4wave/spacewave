[
  {
    "name": "a refusal from an older cursor is reused",
    "replace": [
      [
        "IF c.ver < Current",
        "IF FALSE"
      ]
    ],
    "expect": "PrefixTrue",
    "config": "ReplayRerun.cfg"
  },
  {
    "name": "a missing handler refuses instead of waiting",
    "replace": [
      [
        "NoHandler(i, W) == phase' = \"waiting\" /\\ UNCHANGED pos",
        "NoHandler(i, W) == pos' = Append(pos, [op |-> i, refused |-> TRUE, before |-> W]) /\\ UNCHANGED phase"
      ]
    ],
    "expect": "PrefixTrue",
    "config": "ReplayRerun.cfg"
  },
  {
    "name": "an operation every member refused runs again",
    "replace": [
      [
        "IF MemberRefused(i) THEN",
        "IF FALSE THEN"
      ]
    ],
    "expect": "PrefixTrue",
    "config": "ReplayRerun.cfg"
  },
  {
    "name": "a saved position is reused after a re-run changed the World before it",
    "replace": [
      [
        "/\\ restored[i].before = W",
        ""
      ]
    ],
    "expect": "PrefixTrue",
    "config": "ReplayRerun.cfg"
  },
  {
    "name": "a registered handler does not end the wait",
    "replace": [
      [
        "IF phase = \"waiting\" THEN \"running\" ELSE phase",
        "phase"
      ]
    ],
    "expect": "CatchesUp",
    "config": "ReplayRerun.cfg"
  }
]
