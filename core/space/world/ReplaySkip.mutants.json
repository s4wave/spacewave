[
  {
    "name": "the skip names a position instead of the op's hash",
    "replace": [
      [
        "Skipped(v) == IF v = 0 THEN {} ELSE {e.op : e \\in cfgs[v].skips}",
        "Skipped(v) == IF v = 0 THEN {} ELSE {order[e.at] : e \\in {e \\in cfgs[v].skips : e.at <= Len(order)}}"
      ]
    ],
    "expect": "NoMismatch",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "an applied op the config now skips keeps its place",
    "replace": [
      [
        "                                  \\/ ~(s[i].out = \"applied\" /\\ s[i].op \\in Skipped(v))",
        "                                  \\/ TRUE"
      ]
    ],
    "expect": "SkipHonored",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the owner skips an op it is not waiting at",
    "replace": [
      [
        "Skip(d) == /\\ d \\in Skippers /\\ Waiting(d)",
        "Skip(d) == /\\ d \\in Skippers /\\ Kept(d) = Len(done[d]) /\\ Len(done[d]) < Len(order)"
      ]
    ],
    "expect": "SkipHitsOnlyStalledOp",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a member installs a checkpoint before its config",
    "replace": [
      [
        "Install(d) == /\\ d # \"owner\" /\\ seen[d] >= ck.cfg",
        "Install(d) == /\\ d # \"owner\""
      ]
    ],
    "expect": "NoMismatch",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the config never reaches the member",
    "replace": [
      [
        "WF_vars(Step(d)) /\\ WF_vars(SeeConfig(d)) /\\ WF_vars(Install(d))",
        "WF_vars(Step(d)) /\\ WF_vars(Install(d))"
      ]
    ],
    "expect": "StallExits",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a checkpoint names a config without its skips",
    "replace": [
      [
        "cfg |-> seen[\"owner\"]]",
        "cfg |-> 0]"
      ]
    ],
    "expect": "CheckpointHoldsSkips",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the owner skips past the cap",
    "replace": [
      [
        "           /\\ Cardinality(Held(d)) < MaxLive",
        "           /\\ TRUE"
      ]
    ],
    "expect": "LiveCapped",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a config change prunes a skip the checkpoint does not cover",
    "replace": [
      [
        "LET skips == Live \\cup Held(d) \\cup",
        "LET skips =="
      ]
    ],
    "expect": "Agree",
    "config": "ReplaySkip-Two.cfg"
  },
  {
    "name": "a device counts as settled without the checkpoint",
    "replace": [
      [
        "/\\ Len(done[d]) = Len(order) /\\ HasPrefix(done[d], ck.outs)",
        "/\\ Len(done[d]) = Len(order)"
      ]
    ],
    "expect": "Agree",
    "config": "ReplaySkip-Stale.cfg"
  },
  {
    "name": "a device keeps its refusal of an op after adopting a checkpoint that applied it",
    "replace": [
      [
        "              /\\ done' = [done EXCEPT ![\"owner\"] = ck2.outs]",
        "              /\\ done' = done"
      ]
    ],
    "expect": "StallExits",
    "config": "ReplaySkip-Stale.cfg"
  }
]
