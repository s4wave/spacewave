[
  {
    "name": "the skip names a position instead of the op's hash",
    "replace": [
      [
        "Skipped(v) == IF v = 0 THEN {} ELSE {e.op : e \\in cfgs[v].skips}",
        "Skipped(v) == IF v = 0 THEN {} ELSE {order[e.at] : e \\in {e \\in cfgs[v].skips : e.at <= Len(order)}}"
      ]
    ],
    "expect": "NoMismatch",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "an applied op the config now skips keeps its place",
    "replace": [
      [
        "                                  \\/ ~(s[i].out = \"applied\" /\\ s[i].op \\in Skipped(v))",
        "                                  \\/ TRUE"
      ]
    ],
    "expect": "SkipHonored",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the owner skips an op it is not waiting at",
    "replace": [
      [
        "Skip == /\\ Waiting(\"owner\")",
        "Skip == /\\ Kept(\"owner\") = Len(done[\"owner\"]) /\\ Len(done[\"owner\"]) < Len(order)"
      ]
    ],
    "expect": "SkipHitsOnlyStalledOp",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a member installs a checkpoint before its config",
    "replace": [
      [
        "Install(d) == /\\ d # \"owner\" /\\ seen[d] >= ck.cfg",
        "Install(d) == /\\ d # \"owner\""
      ]
    ],
    "expect": "NoMismatch",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the config never reaches the member",
    "replace": [
      [
        "            /\\ \\A d \\in Devices : WF_vars(Step(d)) /\\ WF_vars(SeeConfig(d))",
        "            /\\ \\A d \\in Devices : WF_vars(Step(d))"
      ]
    ],
    "expect": "StallExits",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a checkpoint names a config without its skips",
    "replace": [
      [
        "cfg |-> seen[\"owner\"]]",
        "cfg |-> 0]"
      ]
    ],
    "expect": "CheckpointHoldsSkips",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "the owner skips past the cap",
    "replace": [
      [
        "        /\\ Cardinality(Live) < MaxLive",
        "        /\\ TRUE"
      ]
    ],
    "expect": "LiveCapped",
    "config": "ReplaySkip.cfg"
  },
  {
    "name": "a config change prunes a skip the checkpoint does not cover",
    "replace": [
      [
        "Live == IF cfgs = <<>> THEN {} ELSE {e \\in cfgs[Len(cfgs)].skips : e.op \\notin Covered}",
        "Live == {}"
      ]
    ],
    "expect": "Agree",
    "config": "ReplaySkip-Two.cfg"
  },
  {
    "name": "a pruned config arrives without its checkpoint",
    "replace": [
      [
        "IF HasPrefix(done[d], Base(Len(cfgs))) THEN done",
        "IF TRUE THEN done"
      ]
    ],
    "expect": "Agree",
    "config": "ReplaySkip.cfg"
  }
]
