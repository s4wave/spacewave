[
  {
    "name": "the postponed run still commits",
    "replace": [
      [
        "CommitGuard == ~fenced /\\ ~qstop",
        "CommitGuard == TRUE"
      ]
    ],
    "expect": "BasesHeld",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "the old adapter settles from its own state before the restart",
    "replace": [
      [
        "SettleReady == told /\\ adopted /\\ (run = \"new\" \\/ (run = \"rerun\" /\\ returned))",
        "SettleReady == run \\in {\"postponed\", \"new\"}"
      ],
      [
        "SettleView == st",
        "SettleView == IF run = \"new\" THEN st ELSE mview"
      ]
    ],
    "expect": "SettleCorrect",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "the client drops an applied write's rows",
    "replace": [
      [
        "/\\ rows' = IF unk \\in SettleView THEN rows ELSE rows \\ {unk}",
        "/\\ rows' = rows \\ {unk}"
      ]
    ],
    "expect": "RowsMatch",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "the client writes again before the settle",
    "replace": [
      [
        "    /\\ ~Held\n    /\\ inflight'",
        "    /\\ inflight'"
      ]
    ],
    "expect": "BasesHeld",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "each mount run starts the World on a new factory, with an empty settle set",
    "replace": [
      [
        "KeptOnRestart == kept",
        "KeptOnRestart == FALSE"
      ]
    ],
    "expect": "SettleKept",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "the next adapter adopts only at its open",
    "replace": [
      [
        "LateAdopt == TRUE",
        "LateAdopt == FALSE"
      ]
    ],
    "expect": "Answered",
    "config": "ReplayUnknownSettle.cfg"
  },
  {
    "name": "the queue drops a call's return once the run's ctx ended",
    "replace": [
      [
        "ReturnRecorded == TRUE",
        "ReturnRecorded == FALSE"
      ]
    ],
    "expect": "Answered",
    "config": "ReplayUnknownSettle.cfg"
  }
]
