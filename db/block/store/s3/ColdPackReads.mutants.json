[
  {
    "name": "Recovery accepts an unqualified legacy row",
    "replace": [["r.current /\\ r.scope = s", "r.scope = s"]],
    "expect": "NoFalseYes",
    "config": "ColdPackReads.cfg"
  },
  {
    "name": "Recovery accepts a row from a different scope",
    "replace": [["r.current /\\ r.scope = s", "r.current"]],
    "expect": "NoFalseYes",
    "config": "ColdPackReads.cfg"
  },
  {
    "name": "Cached proof outlives an observed 404",
    "replace": [
      [
        "Observation(k, ready /\\ enabled /\\ ~gone",
        "Observation(k, ready /\\ enabled /\\ TRUE"
      ]
    ],
    "expect": "NoGoneYes",
    "config": "ColdPackReads.cfg"
  },
  {
    "name": "An authentic index authorizes an unreadable extent",
    "replace": [["(Bound /\\ k \\in tail)", "(k \\in tail)"]],
    "expect": "NoUnreadableYes",
    "config": "ColdPackReads-unreadable.cfg"
  }
]
