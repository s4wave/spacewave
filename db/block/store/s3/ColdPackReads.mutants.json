[
  {
    "name": "A restored 96-bit suffix authorizes a different key",
    "replace": [
      [
        "(TrustSuffix /\\ durable # {})",
        "(durable # {})"
      ]
    ],
    "expect": "NoFalseYes",
    "config": "ColdPackReads.cfg"
  },
  {
    "name": "Cached proof outlives an observed 404",
    "replace": [
      [
        "(~gone \\/ IgnoreGone)",
        "TRUE"
      ]
    ],
    "expect": "NoGoneYes",
    "config": "ColdPackReads.cfg"
  },
  {
    "name": "An authentic index authorizes an unreadable extent",
    "replace": [
      [
        "(Bound /\\ k \\in tail)",
        "(k \\in tail)"
      ]
    ],
    "expect": "NoUnreadableYes",
    "config": "ColdPackReads-unreadable.cfg"
  }
]
