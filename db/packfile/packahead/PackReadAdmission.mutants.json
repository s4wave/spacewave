[
  {
    "name": "admit before the batch syncs",
    "replace": [
      [
        "(~RequireSync /\\ location = \"unsynced\")",
        "(location = \"unsynced\")"
      ]
    ],
    "expect": "CacheBacked"
  },
  {
    "name": "drop a location without invalidating it",
    "replace": [
      [
        "IF InvalidateDrop THEN generation + 1 ELSE generation",
        "generation"
      ]
    ],
    "expect": "CacheBacked"
  },
  {
    "name": "commit a charged slot without rechecking removal",
    "replace": [
      [
        "/\\ sampled = generation\n",
        "/\\ TRUE\n"
      ]
    ],
    "expect": "AdmissionCurrent"
  },
  {
    "name": "delete a newer cache entry after a stale lookup",
    "replace": [
      [
        "IF cached = seenStale",
        "IF cached # 0"
      ]
    ],
    "expect": "PurgeCurrent"
  }
]
