[
  {
    "name": "pre-fix wait has no deadline",
    "replace": [
      [
        "BudgetExpiry == /\\ TRUE",
        "BudgetExpiry == /\\ FALSE"
      ]
    ],
    "expect": "WaitEnds"
  },
  {
    "name": "timeout releases a queued operation",
    "replace": [
      [
        "IF cause = \"close\" /\\ work = \"queued\"",
        "IF work = \"queued\""
      ]
    ],
    "expect": "TimeoutKeepsWork"
  },
  {
    "name": "timeout infers apply from head progress",
    "replace": [
      [
        "/\\ result' = \"unknown\"",
        "/\\ result' = IF laterHead THEN \"applied\" ELSE \"unknown\""
      ]
    ],
    "expect": "ExactOutcome"
  },
  {
    "name": "ReleaseOverflowAtKeep: overflow stage released when Admit returns",
    "replace": [
      [
        "        /\\ overflowStage = TRUE\n",
        "        /\\ overflowStage = FALSE\n"
      ]
    ],
    "expect": "DurableStateHolds"
  },
  {
    "name": "StateBeforeHold: state written before the move lands",
    "replace": [
      [
        "                         /\\ move = \"landed\"\n",
        ""
      ]
    ],
    "expect": "DurableStateHolds"
  }
]
