[
  {
    "name": "a deferred fetch keeps the writer and the SQL writer",
    "replace": [
      [
        "FetchReleasesWriter == TRUE",
        "FetchReleasesWriter == FALSE"
      ]
    ],
    "expect": "NoFetchUnderWriter"
  },
  {
    "name": "a write runs while an earlier write of its actor fetches",
    "replace": [
      [
        "ActorGuard == TRUE",
        "ActorGuard == FALSE"
      ]
    ],
    "expect": "ActorWaitsForFetch"
  },
  {
    "name": "a write answered at admission defers and moves behind later writes",
    "replace": [
      [
        "/\\ s.pc[i] = \"body\" /\\ i \\notin s.answered\n  /\\ RoundGuard",
        "/\\ s.pc[i] = \"body\"\n  /\\ RoundGuard"
      ]
    ],
    "expect": "ActorWaitsForFetch"
  },
  {
    "name": "a write past its fetch rounds defers again",
    "replace": [
      [
        "RoundGuard == TRUE",
        "RoundGuard == FALSE"
      ]
    ],
    "expect": "BoundedFetches"
  }
]
