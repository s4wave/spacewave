# spacewave-init mounts these before it can load any module from a Volume.
# ip=dhcp configures the network before init, which binds /proc/net/pnp as
# the image's resolv.conf; the kernel never renews that lease.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BTRFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_FUSE_FS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_PROC_FS=y
CONFIG_RD_LZ4=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
