[
  {
    "name": "replacement discards attached data",
    "replace": [["vm = 2 /\\ ~PreserveBindings", "vm = 2"]],
    "expect": "SameAttachedObjects"
  },
  {
    "name": "replacement starts before stop confirmation",
    "replace": [
      ["Replace == /\\ phase = \"off\"", "Replace == /\\ phase = \"stopping\""]
    ],
    "expect": "ReplacedAfterStop"
  }
]
