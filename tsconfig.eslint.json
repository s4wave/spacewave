{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "*.js",
    "*.mjs",
    "*.ts",
    "app/**/*",
    "web/**/*",
    "core/**/*",
    "sdk/**/*",
    "plugin/**/*",
    "cmd/**/*",
    "net/**/*.ts",
    "db/**/*.ts",
    "forge/lib/v86/bun/**/*.ts",
    "bldr/*.ts",
    "bldr/global.d.ts",
    "bldr/types/**/*",
    "bldr/web/**/*",
    "bldr/sdk/**/*",
    "bldr/plugin/**/*",
    "bldr/example/**/*",
    "bldr/entrypoint/**/*",
    "bldr/util/**/*",
    "bldr/e2e/**/*",
    "bldr/resource/**/*",
    "bldr/scripts/**/*",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "dist",
    ".bldr",
    ".bldr-dist",
    "bldr/dist",
    "bldr/e2e/comms/dist",
    "bldr/plugin/compiler/js/.test",
    "bldr/devtool",
    "bldr/manifest",
    "bldr/prototypes",
    "bldr/storage",
    "bldr/web/saucer/build",
    "hydra",
    "vite-check",
    "coverage",
    "bundle",
    "runtime",
    "app/prerender/dist",
    "app/prerender/ssr-dist",
    "e2e/wasm/memlab",
    "**/*.pb.ts",
    "**/*.pb.js",
    "**/*.esm.js",
    ".tmp"
  ]
}
